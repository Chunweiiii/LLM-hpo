# === 機密 ===
.env
config/.env

# === Python ===
__pycache__/
*.pyc
venv/

# === Claude Code 本機設定(僅本機用,不是專案內容) ===
.claude/

# === 大型/可重新產生的實驗產物 ===
# runs/ 是每一輪訓練的權重(best.pt/last.pt)與過程圖,體積龐大且可由
# results/*.json + src/hpo_loop.py 重新產生,不需要進版控。核心實驗結果
# (排名依據)都已抽取到 results/ 底下的 json,那些才是論文引用的資料。
runs/

# 預訓練權重,可由 ultralytics 重新下載
weights/
yolov8n.pt

# === OS ===
.DS_Store
Thumbs.db

# === 一次性腳本/工具(不是可重複使用的核心流程)===
# find_batch_size.py:只在新機器上跑一次找 batch size 用,結果已經手動填進
# config/settings.yaml,不用再跑。run_baseline_3seed.py(scripts/ 底下這份):
# 已停用的舊版,被 experiments/run_baseline_3seed.py 取代,檔案開頭直接
# raise RuntimeError。run_remaining_queue.py:一次性的排隊執行腳本,
# 對應 remaining_queue_log.txt 那次收尾。regenerate_report_for_example.py:
# 檔案開頭就寫明是「一次性小工具」,重組 few-shot example 用的。
scripts/find_batch_size.py
scripts/run_baseline_3seed.py
scripts/run_remaining_queue.py
regenerate_report_for_example.py

# === 一次性執行紀錄(queue log)===
budgetaware_queue_log.txt
overnight_queue_log.txt
rep2_queue_log.txt
remaining_queue_log.txt
round11_queue_log.txt

# === 產出物暫存資料夾(草稿/被否決的圖表版本,不是最終要交付的東西)===
# 最終要給雪糕/放論文的圖表在 figure/ 底下(有進版控),這個資料夾是產圖
# 過程中的草稿、被否決的版本、重複檔案,不需要進版控。
Claude outputs/

# === 之前跑過、但沒有畫在最終圖表上的模型/方法紀錄 ===
# 2026-09-26 更新:Claude Haiku 4.5 補跑 --hinted 後,四個模型
# (llama3.1-8b / phi4-14b / gemma4-12b / claude-haiku-4.5)的診斷組正式
# 統一都用 hinted prompt(見 docs/decisions.md)。llama/phi4/gemma 三個
# 小模型的 hinted 結果檔案名稱先前已經拿掉 "_hinted" 後綴(hinted 就是
# 正式診斷組,不用特別標記);Claude Haiku 4.5 則反過來,新的 hinted
# 結果檔案「保留」"_hinted" 後綴(因為它自己還有一份舊的非 hinted
# full_diagnosis_claude-haiku-4.5.json 留著當參考,兩份要分得開)。
# scripts/plot_trajectory.py、scripts/plot_ranking_table.py 兩支畫圖
# script 現在就是讀下面白名單這幾個檔名,務必跟這裡保持一致,不然
# clone 下來的人跑畫圖 script 會找不到檔案,或者接收到過期的舊數字。
results/*.json
!results/baseline_3seed.json
!results/d4_d5_thresholds.json
!results/full_diagnosis_llama3.1-8b.json
!results/score_only_llama3.1-8b.json
!results/full_diagnosis_phi4-14b.json
!results/score_only_phi4-14b.json
!results/full_diagnosis_gemma4-12b.json
!results/score_only_gemma4-12b.json
!results/full_diagnosis_claude-haiku-4.5_hinted.json
!results/score_only_claude-haiku-4.5.json
